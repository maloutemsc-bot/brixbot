# --------------------------------------------------------------------------- #
#  BrixBot — variables d'environnement du bot WhatsApp (Node.js)
#  Copiez ce fichier en ".env" dans le dossier whatsapp-bot/.
# --------------------------------------------------------------------------- #

# URL du backend Flask
#   - en local :  http://localhost:5000
#   - Docker   :  http://backend:5000
#   - Render   :  https://votre-backend.onrender.com
FLASK_INTERNAL_URL=http://localhost:5000

# Clé partagée bot <-> backend — DOIT être identique dans backend/.env
BOT_API_KEY=changez-moi-bot

# Port du serveur interne Express du bot (défaut : 3000)
BOT_PORT=3000

# Dossier de session WhatsApp (défaut : auth_info)
AUTH_DIR=auth_info

# Niveau de logs pino : silent | error | warn | info (défaut : silent)
LOG_LEVEL=silent

# Journal des conversations (transcript.txt) : [heure] [nom contact] [message]
# Mettre TRANSCRIPT_ENABLED=0 pour désactiver. Le fichier est tronqué à 5 Mo.
TRANSCRIPT_ENABLED=1
TRANSCRIPT_FILE=transcript.txt
