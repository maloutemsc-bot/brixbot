# --------------------------------------------------------------------------- #
#  BrixBot — variables d'environnement racine (utilisées par docker-compose)
#  Copiez ce fichier en ".env" à la racine du projet puis lancez :
#      docker compose up --build
# --------------------------------------------------------------------------- #

# Clé secrète Flask
SECRET_KEY=changez-moi-cette-cle

# Mot de passe du panneau d'administration (laisser vide pour désactiver)
ADMIN_PASSWORD=

# Numéro du propriétaire en chiffres (ex: 33612345678) — commandes .ia depuis WhatsApp
OWNER_NUMBER=

# Clé API BrixHub
BRIX_API_KEY=

# Clé API GROQ
GROQ_API_KEY=

# Clé partagée bot <-> backend (identique des deux côtés)
BOT_API_KEY=changez-moi-bot
