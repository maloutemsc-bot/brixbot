# --------------------------------------------------------------------------- #
#  BrixBot — variables d'environnement du backend Flask
#  Copiez ce fichier en ".env" et renseignez vos valeurs.
# --------------------------------------------------------------------------- #

# Clé secrète de l'application Flask (obligatoire en production)
SECRET_KEY=changez-moi-cette-cle

# Mot de passe du panneau d'administration (laisser vide pour désactiver)
# ⚠️ FORTEMENT recommandé si le panneau est accessible publiquement (Render)
ADMIN_PASSWORD=

# Numéro du propriétaire en chiffres (ex: 33612345678) — permet les commandes
# .ia oui / .ia non / .ia liste depuis WhatsApp pour gérer la whitelist de l'IA.
# Laisser vide pour désactiver les commandes .ia.
OWNER_NUMBER=

# Clé API BrixHub (optionnel si renseignée dans le panneau, onglet Configuration)
BRIX_API_KEY=

# Clé API GROQ (optionnel si renseignée dans le panneau, onglet IA)
GROQ_API_KEY=

# Clé partagée bot <-> backend — DOIT être identique dans whatsapp-bot/.env
BOT_API_KEY=changez-moi-bot

# URL interne du bot Node.js (utilisée par Flask pour redémarrer le bot)
#   - en local :  http://localhost:3000
#   - Docker   :  http://bot:3000
#   - Render   :  https://votre-bot.onrender.com
BOT_INTERNAL_URL=http://localhost:3000

# Base de données SQLite (optionnel, chemin par défaut : backend/instance/bot.db)
# DATABASE_URL=sqlite:///instance/bot.db

# Mode debug Flask (true/false)
FLASK_DEBUG=false
